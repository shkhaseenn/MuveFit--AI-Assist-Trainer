# ============================================================
# MuveFit — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=MuveFit API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ── Server ──────────────────────────────────────────────────
# Port for the FastAPI backend (used by uvicorn)
PORT=8000

# ── Database ────────────────────────────────────────────────
# SQLite (default for local development)
DATABASE_URL=sqlite:///./backend/muvefit.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/muvefit

DATABASE_echo=false

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Production (replace with your actual frontend domain):
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Authentication ──────────────────────────────────────────
# Secret key for JWT token generation (use a long random string)
# JWT_SECRET_KEY=your-super-secret-key-here

# Token expiration in minutes (default: 60)
# JWT_EXPIRATION_MINUTES=60

# ── AI Provider (Optional) ──────────────────────────────────
# OpenAI API key for AI Coach (optional, falls back to rule-based)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================
# Frontend Environment Variables (prefix with VITE_)
# ============================================================
# These are set in frontend/.env

# Backend API URL
VITE_API_URL=http://localhost:8000
